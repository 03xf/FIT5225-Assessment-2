# Local development. Do not commit real cloud credentials.
PACIFICBIO_ENV=development
PACIFICBIO_DATABASE_URL=sqlite:///./data/pacificbio.sqlite3
PACIFICBIO_STORAGE_ROOT=./uploads
PACIFICBIO_JWT_SECRET=replace-with-a-long-random-local-secret
PACIFICBIO_COGNITO_USER_POOL_ID=
PACIFICBIO_COGNITO_APP_CLIENT_ID=
PACIFICBIO_ALIBABA_PROCESSOR_URL=
PACIFICBIO_ALIBABA_REGION=cn-hangzhou
PACIFICBIO_ALIBABA_OSS_BUCKET=
PACIFICBIO_ALIBABA_OSS_ENDPOINT=
PACIFICBIO_WORKER_SHARED_KEY=
PACIFICBIO_MODEL_MANIFEST=models/model-manifest.json

