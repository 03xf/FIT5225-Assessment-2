# Use the public ECR mirror so the image source is available from the same
# registry family as the AWS deployment path (and not only Docker Hub).
FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /service
RUN apt-get update && apt-get install --no-install-recommends -y ffmpeg libgl1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /service/requirements.txt
COPY worker/requirements.txt /service/worker-requirements.txt
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.3.1 torchvision==0.18.1 \
 && pip install --no-cache-dir -r /service/requirements.txt -r /service/worker-requirements.txt
COPY worker /service/worker
RUN mkdir -p /models
# Model weights never enter the container image or Git history. Function Compute
# restores these checksum-pinned objects from the private Alibaba OSS bucket.
COPY models/model-manifest.json models/labels.txt /models/
ENV MODEL_ROOT=/models MODEL_MANIFEST=/models/model-manifest.json PYTHONPATH=/service
CMD ["uvicorn", "worker.main:app", "--host", "0.0.0.0", "--port", "8080"]
