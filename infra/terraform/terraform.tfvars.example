gcp_project_id   = "replace-with-your-gcp-project-id"
aws_region       = "ap-southeast-2"
gcp_region       = "australia-southeast1"
aws_account_id          = "123456789012"
cognito_domain_prefix   = "replace-with-a-globally-unique-prefix"
# First apply can use a temporary HTTPS site or localhost; after the API is
# created, replace these with the `api_gateway_url` output and apply again.
ui_callback_urls = ["http://localhost:8000"]
ui_logout_urls   = ["http://localhost:8000"]
# Supply immutable digest URIs after the bootstrap apply creates repositories.
api_lambda_image_uri = ""
dispatcher_lambda_image_uri = ""
worker_image_uri     = ""
